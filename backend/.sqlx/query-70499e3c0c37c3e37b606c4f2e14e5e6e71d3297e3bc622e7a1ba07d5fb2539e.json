  "query": "\n        SELECT \n            m.id, m.nombre, m.categoria_id, c.nombre as \"categoria_nombre?\",\n            m.formato::text as \"formato!\", m.dosis::float8 as \"dosis!\", \n            m.unidad_dosis, m.notas\n        FROM medicamento m\n        LEFT JOIN categoria_medicamento c ON m.categoria_id = c.id\n        ORDER BY m.nombre\n        ",
