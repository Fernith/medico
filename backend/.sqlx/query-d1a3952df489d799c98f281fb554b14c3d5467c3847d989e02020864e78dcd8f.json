  "query": "\n        SELECT \n            id, \n            fecha, \n            peso::FLOAT8 as \"peso!\", \n            en_ayunas,\n            AVG(peso) OVER (\n                ORDER BY fecha ASC \n                ROWS BETWEEN 3 PRECEDING AND CURRENT ROW\n            )::FLOAT8 as promedio\n        FROM pesos \n        ORDER BY fecha DESC\n        ",
