{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            r.id, \n            r.nombre,\n            r.ejercicio_id, \n            e.nombre as \"ejercicio_nombre\", \n            e.imagen as \"ejercicio_imagen?\", \n            r.equipamiento_id, \n            (SELECT nombre FROM equipamiento WHERE id = r.equipamiento_id) as \"equipamiento_nombre\",\n            r.carga_actual, \n            r.unidad_carga, \n            r.series, \n            r.reps_min, \n            r.reps_max,\n            r.unidad_objetivo,\n            r.descanso,\n            r.activo,\n            e.activo as \"ejercicio_activo\"\n        FROM realizacion_ejercicio r\n        JOIN ejercicios e ON r.ejercicio_id = e.id\n        ORDER BY e.nombre\n        ",
